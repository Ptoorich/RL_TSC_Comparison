<?xml version="1.0" encoding="UTF-8"?>
<!-- Visualisation demo: 4int network with random demand.
     Watch junction cluster_54994556_7161921429 (the 6-phase one).
     Delete gui_demo_* files when done - not needed for training. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="4int_osm.net.xml"/>
        <route-files value="gui_demo_random.rou.xml"/>
        <additional-files value="osm.poly.xml.gz"/>
    </input>

    <processing>
        <ignore-route-errors value="true"/>
    </processing>

    <report>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="osm.view.xml"/>
    </gui_only>

</sumoConfiguration>
